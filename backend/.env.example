DB_USER=         # Usuario de la base de datos
DB_PASSWORD=     # Password de la base de datos
DB_HOST=         # Host de la base de datos    host.docker.internal SI UTILIZAS DOCKER / localhost SI NO UTILIZAS DOCKER
DB_PORT=         # Puerto de la base de datos
DB_NAME=         # Nombre de la base de datos

SECRET_KEY=      # Clave secreta para la aplicación
ALGORITHM=       # Algoritmo de cifrado para JWT
ADMIN_2FA_KEY=   # Clave de 2FA para el administrador

SMTP_SERVER=    # Servidor SMTP para enviar correos
SMTP_PORT=     # Puerto SMTP
SENDER_EMAIL=  # Correo electrónico del remitente
SENDER_PASSWORD= # Contraseña del correo electrónico del remitente (o contraseña de aplicación si usas Gmail)